# --- Secrets: OAuth client credentials and tokens -------------------------
# The real client secret lives in ~/.config/vitalglass/, but guard against
# a copy ending up in the working tree by accident.
client_secret*.json
credentials*.json
token*.json
*.token
.env
.env.*
!.env.example

# --- Health data: local cache and any exported/dumped API responses -------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Raw API dumps from the spike / debugging. Keep scratch output here.
/data/
/dumps/
*.response.json

# --- Rust / Tauri build output --------------------------------------------
/target/
**/target/
src-tauri/gen/

# --- Node / frontend build output -----------------------------------------
node_modules/
dist/
build/
.svelte-kit/
.vite/

# --- Python (spike, if used) ----------------------------------------------
__pycache__/
*.pyc
.venv/

# --- Editor / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store

# --- Local Claude Code settings -------------------------------------------
.claude/settings.local.json
